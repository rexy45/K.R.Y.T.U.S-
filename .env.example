# Krytus - Personal AI Chief of Staff
# Copy this file to .env and fill in your credentials

# ============================================
# LLM PROVIDER SELECTION
# ============================================
# Choose: "openai" or "gemini"
LLM_PROVIDER=gemini

# ============================================
# OPENAI CONFIGURATION (if LLM_PROVIDER=openai)
# Get from https://platform.openai.com/api-keys
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ============================================
# GOOGLE GEMINI CONFIGURATION (if LLM_PROVIDER=gemini)
# Get from https://aistudio.google.com/app/apikey
# ============================================
GOOGLE_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-1.5-flash

# ============================================
# REQUIRED: Telegram Bot Configuration
# Get from @BotFather on Telegram
# ============================================
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Your personal Telegram user ID (numeric)
# Get this by messaging @userinfobot on Telegram
MY_TELEGRAM_CHAT_ID=123456789

# ============================================
# REQUIRED: Email Configuration (Gmail App Password)
# Enable 2FA on Google Account, then create App Password:
# https://myaccount.google.com/apppasswords
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=your-email@gmail.com

# ============================================
# TTS CONFIGURATION (Edge TTS)
# Voice options: https://github.com/rany2/edge-tts
# English: en-US-AriaNeural, en-US-JennyNeural, en-US-GuyNeural
# Hindi: hi-IN-SwaraNeural, hi-IN-MadhurNeural
# ============================================
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ============================================
# OPTIONAL: ChromaDB Persistence Path
# ============================================
CHROMA_DB_PATH=./data/chromadb

# ============================================
# OPTIONAL: SQLite Database Path
# ============================================
SQLITE_DB_PATH=./data/krytus.db