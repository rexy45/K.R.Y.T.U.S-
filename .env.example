# Krytus Bot - Environment Variables
# Copy to .env and fill in your values

# LLM Provider (openai or gemini)
LLM_PROVIDER=gemini

# OpenAI (if using openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini (if using gemini)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Telegram Bot (REQUIRED)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
MY_TELEGRAM_CHAT_ID=your_telegram_user_id

# Telegram API (REQUIRED for live voice calls on Railway)
# Get from https://my.telegram.org
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your@gmail.com

# TTS Configuration
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# Database paths (auto-created)
CHROMA_DB_PATH=./data/chromadb
SQLITE_DB_PATH=./data/krytus.db